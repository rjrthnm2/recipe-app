rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Superusers carry a custom "admin" claim on their auth token, granted
    // out-of-band via scripts/setAdmins.js. No emails are stored here.
    function isSuperuser() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Every field a recipe document may contain. Writes with any other
    // field are rejected, which blocks junk data and ownership spoofing.
    function hasOnlyRecipeFields(data) {
      return data.keys().hasOnly([
        'title', 'author_note', 'prep_time', 'cook_time', 'servings',
        'tags', 'ingredients', 'directions', 'url',
        'ownerId', 'ownerName', 'createdAt'
      ]);
    }

    function isValidRecipe(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.tags is list && data.tags.size() <= 25
        && data.ingredients is list && data.ingredients.size() <= 150
        && data.directions is list && data.directions.size() <= 60;
    }

    // Master recipe list.
    match /recipes/{recipeId} {
      allow read: if true;                 // anyone can browse, no login needed
      // Any signed-in user can add a recipe, but only with known fields,
      // sane sizes, and their own account id as the owner stamp.
      allow create: if isSignedIn()
        && hasOnlyRecipeFields(request.resource.data)
        && isValidRecipe(request.resource.data)
        && request.resource.data.url == recipeId
        && request.resource.data.ownerId == request.auth.uid;
      // Only the two owners can edit, and edits cannot introduce new fields.
      allow update: if isSuperuser()
        && hasOnlyRecipeFields(request.resource.data)
        && isValidRecipe(request.resource.data);
      allow delete: if isSuperuser();
    }

    // Each user's personal saved ("My List") document.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Archive written automatically when a superuser deletes a recipe.
    match /deleted_recipes/{recipeId} {
      allow read, write: if isSuperuser();
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
